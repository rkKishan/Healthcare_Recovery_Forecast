# ---------------------------------------------------------------------------
# Copy to .env and adjust. Never commit the real .env.
# ---------------------------------------------------------------------------

# Security -- generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-character-hex-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=12

# Database
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///data/app.db
# MySQL:
# DATABASE_URL=mysql+pymysql://forecast:forecast@localhost:3306/healthcare_forecast

# API
API_HOST=0.0.0.0
API_PORT=2800
FLASK_DEBUG=true

# Frontend origin(s) allowed by CORS, comma-separated
CORS_ORIGINS=http://localhost:9000

# Uploads
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=64

# Models
MODELS_DIR=models
WARM_EXPLAINER=true

# Hospital capacity used by the bed-occupancy forecast
# 0 = size the ward to the uploaded cohort at 85% baseline occupancy
TOTAL_BEDS=0

# Google Sign-In
# The OAuth *client id* only -- it is public and is served to the browser.
# There is no client secret: the browser gets an ID token from Google and the
# API verifies it against Google's public keys.
#
# Create one at https://console.cloud.google.com/apis/credentials
#   Application type: Web application
#   Authorised JavaScript origins: http://localhost:9000, http://localhost:2800
# Leave blank to hide the Google button and use password login only.
GOOGLE_CLIENT_ID=
# Optional: restrict sign-in to one or more Google Workspace domains.
# Blank means any verified Google account may sign in.
GOOGLE_ALLOWED_DOMAINS=

# Demo accounts seeded on first run -- one per role, sharing DEMO_PASSWORD.
#
# Seeding runs on every boot and skips only accounts that already exist, so
# leaving it on in a real deployment puts the published password back after
# anyone deletes those accounts. Setting ADMIN_EMAILS below therefore turns
# seeding off by default, and the demo admin is never seeded as an admin.
# Setting this explicitly overrides that either way.
SEED_DEMO_USERS=true
DEMO_EMAIL=admin@hospital.org
DEMO_PASSWORD=demo1234
DEMO_NAME=Dr. Alex Morgan
DEMO_DOCTOR_EMAIL=doctor@hospital.org
DEMO_DOCTOR_NAME=Dr. Priya Nair
DEMO_ANALYST_EMAIL=analyst@hospital.org
DEMO_ANALYST_NAME=Jordan Mehta

# --- administrators ---------------------------------------------------------
# Comma-separated. These addresses get the admin role -- on registration, and
# on their next sign-in if the account already exists. Editing this list is
# how you add or remove an administrator; there is no way to request the role
# through the API, and no seeded admin account.
# Empty means the feature is unconfigured and nobody's role is changed.
ADMIN_EMAILS=

# --- assistant -------------------------------------------------------------
# The in-app chat assistant. Optional: with no key the /api/chat/config
# endpoint reports itself disabled and the UI omits the panel entirely.
# Free key from https://console.groq.com/keys -- no payment method required.
GROQ_API_KEY=

# Pinned rather than an alias, so a provider-side model refresh cannot
# silently change how the assistant behaves. llama-3.1-8b-instant is the
# faster, weaker alternative.
GROQ_MODEL=openai/gpt-oss-120b
